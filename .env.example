# Your domain; its DNS A (and AAAA) record must point at the server before the first start.
DOMAIN=agentic.example.com

# Real accounts (email + password). While ACCESS_CODE is set, sign-up is invite-only:
# new members need the code. Clear ACCESS_CODE to open sign-up to everyone.
SIGNUP=true
ACCESS_CODE=change-me-to-a-long-random-string

# Development sign-in as a member of the seeded demo network (also gated by ACCESS_CODE).
# Turn it off once real members use the server.
DEV_LOGIN=true

# Seed the fictional demo network into an empty database on first start.
SEED_DEMO=true

# Intents one IP (or one signed-in member) may submit per hour.
SUBMIT_PER_HOUR=30

# Sign-up and password attempts one IP may make per 10 minutes.
AUTH_ATTEMPTS_PER_10_MIN=20

# Email (invitations). Without SMTP_HOST nothing is sent: invitations are refused and
# personal invite links still work. Hetzner blocks outgoing ports 25 and 465, so use a
# transactional provider (Postmark, Brevo, Mailgun, Amazon SES…) on port 587, and set up
# SPF and DKIM for MAIL_FROM's domain at your DNS provider as the provider explains.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@agentic.example.com
MAIL_FROM_NAME=Agentic Business Network
# Invitations one member may send per day.
INVITES_PER_DAY=200
